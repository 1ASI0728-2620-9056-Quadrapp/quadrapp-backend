# Copy to deploy/.env (never commit it) and replace every change-me value:
#   cp env.example .env && chmod 600 .env
# Generate secrets on the instance, for example: openssl rand -base64 48

# --- Host names and TLS ---------------------------------------------------------
# Both names point to the Elastic IP of the instance (A records).
API_DOMAIN=api.example.com
MQTT_DOMAIN=mqtt.example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=change-me@example.com
# acme: Let's Encrypt (production). internal: Caddy's local CA, only for testing on a laptop.
TLS_MODE=acme
# Host ports. Keep 443 and 8883 on the instance.
HTTPS_PORT=443
MQTTS_PORT=8883

# --- Backend image ----------------------------------------------------------------
BACKEND_IMAGE=ghcr.io/1asi0728-2620-9056-quadrapp/quadrapp-backend
# develop, main, a release tag, or sha-<7 chars> to pin one build.
BACKEND_TAG=develop

# --- PostgreSQL --------------------------------------------------------------------
POSTGRES_DB=quadrapp
POSTGRES_USER=quadrapp
POSTGRES_PASSWORD=change-me

# --- Backend secrets ---------------------------------------------------------------
# Base64 key of at least 32 bytes: openssl rand -base64 48
JWT_SECRET_BASE64=change-me
# Base64 value: openssl rand -base64 32
OTP_HASH_PEPPER_BASE64=change-me
# Page of the web console that accepts invitations.
INVITATION_URL_BASE=https://console.example.com/accept-invitation

# --- Mail (Brevo SMTP relay) ---------------------------------------------------------
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# Brevo SMTP login and SMTP key (Brevo > SMTP & API > SMTP).
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
# A sender verified in Brevo.
MAIL_FROM=no-reply@example.com
# Both true for Brevo (port 587 with STARTTLS). application.properties sets them to false for Mailpit.
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# --- MQTT --------------------------------------------------------------------------
# Administrator of the dynamic security plugin (used only by deploy/scripts).
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=change-me
# Client the backend uses; it can only subscribe to quadrapp/#.
MQTT_BACKEND_USERNAME=backend
MQTT_BACKEND_PASSWORD=change-me
QUADRAPP_MQTT_ENABLED=true
QUADRAPP_MQTT_URL=tcp://mosquitto:1883
QUADRAPP_MQTT_CLIENT_ID=quadrapp-backend-1
QUADRAPP_MQTT_SHARED_GROUP=sensing

# --- Backups -----------------------------------------------------------------------
# Bucket and prefix for deploy/scripts/backup-db.sh (the instance role must allow s3:PutObject).
BACKUP_S3_URI=s3://change-me-quadrapp-backups/postgres
